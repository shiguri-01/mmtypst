{
  "name": "mmtypst",
  "version": "0.1.0",
  "description": "Parse Typst math expressions and output MathML for browsers and servers.",
  "keywords": [
    "math",
    "mathml",
    "typst"
  ],
  "homepage": "https://github.com/shiguri-01/mmtypst#readme",
  "bugs": {
    "url": "https://github.com/shiguri-01/mmtypst/issues"
  },
  "license": "MIT",
  "author": {
    "name": "shiguri",
    "url": "https://github.com/shiguri-01"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiguri-01/mmtypst.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --run",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "bump": "bumpp"
  },
  "devDependencies": {
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
